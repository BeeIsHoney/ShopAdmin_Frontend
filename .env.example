# Copy to .env.local if it does not exist, or add these keys to the existing file.
# Backend base URLs only. Do not append /api or an endpoint path.
SHOP_BACKEND_URL=http://127.0.0.1:8081
MAIN_BACKEND_URL=http://127.0.0.1:8080
# The assigned shop is resolved from the owner account; no shop code is entered.

# Optional extra frontend hostnames (no https://). *.trycloudflare.com is already allowed.
FRONTEND_ALLOWED_HOSTS=
