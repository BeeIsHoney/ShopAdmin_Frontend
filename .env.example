# Tornado Shop Admin Frontend — backend URLs are server-only Next.js variables.
# Set in Vercel Project Settings > Environment Variables.
SHOP_BACKEND_URL=https://tornadoserviceshopbackend-production.up.railway.app
MAIN_BACKEND_URL=https://tornadoservicemainbackend-production.up.railway.app
# Optional extra hostname support for local development, no scheme.
FRONTEND_ALLOWED_HOSTS=
# Local development can use 127.0.0.1:8081 and 127.0.0.1:8080 in .env.local.
